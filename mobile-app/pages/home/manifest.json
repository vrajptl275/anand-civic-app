{
  "id": "/?source=pwa",
  "name": "Civic-Plus System",
  "short_name": "Civic+",
  "description": "Anand City Civic Issue Reporting native App system.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#1e3c72",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "government",
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Report New Issue",
      "short_name": "Report",
      "description": "Quickly report a new civic issue in Anand city.",
      "url": "./index.html?action=report",
      "icons": [
        {
          "src": "icon.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Civic Issue Dashboard"
    },
    {
      "src": "screenshot.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Complaint Tracker"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+civic",
      "url": "./index.html?action=%s"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "description",
      "url": "link"
    }
  },
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "https://anand-civic-backend.onrender.com"
    }
  ],
  "widgets": [
    {
      "name": "Civic Stats",
      "short_name": "Stats",
      "description": "Civic Platform issue counters.",
      "tag": "civic-counter",
      "ms_ac_template": "template.json",
      "data": "data.json",
      "type": "application/json"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./index.html?action=note"
  }
}