{
  "id": "/?source=pwa",
  "name": "Civic-Plus System",
  "short_name": "Civic+",
  "description": "Anand City Civic Issue Reporting native App system.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#1e3c72",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "government",
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Report New Issue",
      "short_name": "Report",
      "description": "Quickly report a new civic issue in Anand city.",
      "url": "./index.html?action=report",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Civic Issue Dashboard"
    },
    {
      "src": "screenshot-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Tracker"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+civic",
      "url": "./index.html?action=%s"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.example.app1",
      "id": "com.example.app1"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "description",
      "url": "link"
    }
  },
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "*.onrender.com"
    }
  ],
  "widgets": [
    {
      "name": "Civic Stats Dashboard",
      "short_name": "Stats",
      "description": "Civic Platform issue counters.",
      "tag": "civic-counter",
      "template_url": "https://anand-civic-backend.onrender.com/template.json",
      "ms_ac_template": "https://anand-civic-backend.onrender.com/template.json",
      "data": "https://anand-civic-backend.onrender.com/data.json",
      "type": "application/json",
      "auth_base_url": "https://anand-civic-backend.onrender.com/login",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ],
      "screenshots": [
        {
          "src": "screenshot-wide.png",
          "sizes": "1920x1080",
          "type": "image/png",
          "label": "Widget View"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "./index.html?action=note"
  }
}